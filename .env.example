NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_card?schema=public
GRAPHQL_MAX_DEPTH=6
# Log every SQL statement Prisma executes (useful to verify there is no N+1)
LOG_SQL=false
# Number of reverse proxies in front of the app; needed to log the real client IP
TRUST_PROXY_HOPS=0
